{
 "fn": "find_kth_largest",
 "cases": [
  {
   "name": "third largest",
   "args": [
    [
     3,
     2,
     1,
     5,
     6,
     4
    ],
    3
   ],
   "expected": 4
  },
  {
   "name": "largest",
   "args": [
    [
     7,
     2,
     9,
     4
    ],
    1
   ],
   "expected": 9
  },
  {
   "name": "smallest",
   "args": [
    [
     7,
     2,
     9,
     4
    ],
    4
   ],
   "expected": 2
  },
  {
   "name": "duplicates count separately",
   "args": [
    [
     3,
     2,
     3,
     1,
     2,
     4,
     5,
     5,
     6
    ],
    4
   ],
   "expected": 4
  },
  {
   "name": "single element",
   "args": [
    [
     8
    ],
    1
   ],
   "expected": 8
  },
  {
   "name": "negatives",
   "args": [
    [
     -4,
     -1,
     -7,
     -3
    ],
    2
   ],
   "expected": -3
  },
  {
   "name": "all equal",
   "args": [
    [
     5,
     5,
     5,
     5
    ],
    3
   ],
   "expected": 5
  },
  {
   "name": "already sorted",
   "args": [
    [
     1,
     2,
     3,
     4,
     5,
     6
    ],
    2
   ],
   "expected": 5
  }
 ]
}
