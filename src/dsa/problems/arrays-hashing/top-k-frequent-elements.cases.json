{
 "fn": "top_k_frequent",
 "compare": "unordered",
 "cases": [
  {
   "name": "two leaders",
   "args": [
    [
     9,
     9,
     9,
     4,
     4,
     6
    ],
    2
   ],
   "expected": [
    9,
    4
   ]
  },
  {
   "name": "single element",
   "args": [
    [
     8
    ],
    1
   ],
   "expected": [
    8
   ]
  },
  {
   "name": "ties broken by count",
   "args": [
    [
     4,
     4,
     4,
     5,
     5,
     6,
     6,
     6,
     6
    ],
    2
   ],
   "expected": [
    6,
    4
   ]
  },
  {
   "name": "negatives",
   "args": [
    [
     -1,
     -1,
     -2
    ],
    1
   ],
   "expected": [
    -1
   ]
  },
  {
   "name": "zero is a value",
   "args": [
    [
     3,
     0,
     1,
     0
    ],
    1
   ],
   "expected": [
    0
   ]
  },
  {
   "name": "k equals distinct count",
   "args": [
    [
     1,
     2
    ],
    2
   ],
   "expected": [
    1,
    2
   ]
  },
  {
   "name": "all the same",
   "args": [
    [
     5,
     5,
     5,
     5,
     5
    ],
    1
   ],
   "expected": [
    5
   ]
  },
  {
   "name": "three tiers",
   "args": [
    [
     1,
     1,
     2,
     2,
     2,
     3,
     3,
     3,
     3
    ],
    3
   ],
   "expected": [
    3,
    2,
    1
   ]
  }
 ]
}
