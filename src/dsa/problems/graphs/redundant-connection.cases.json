{
 "fn": "find_redundant_connection",
 "cases": [
  {
   "name": "triangle",
   "args": [
    [
     [
      2,
      1
     ],
     [
      3,
      2
     ],
     [
      1,
      3
     ]
    ]
   ],
   "expected": [
    1,
    3
   ]
  },
  {
   "name": "later edge closes the cycle",
   "args": [
    [
     [
      1,
      3
     ],
     [
      3,
      5
     ],
     [
      2,
      5
     ],
     [
      4,
      2
     ],
     [
      1,
      2
     ]
    ]
   ],
   "expected": [
    1,
    2
   ]
  },
  {
   "name": "cycle of three among five",
   "args": [
    [
     [
      1,
      2
     ],
     [
      2,
      3
     ],
     [
      3,
      1
     ],
     [
      3,
      4
     ],
     [
      4,
      5
     ]
    ]
   ],
   "expected": [
    3,
    1
   ]
  },
  {
   "name": "last edge is redundant",
   "args": [
    [
     [
      1,
      2
     ],
     [
      1,
      3
     ],
     [
      3,
      4
     ],
     [
      2,
      4
     ]
    ]
   ],
   "expected": [
    2,
    4
   ]
  },
  {
   "name": "star plus one",
   "args": [
    [
     [
      1,
      2
     ],
     [
      1,
      3
     ],
     [
      1,
      4
     ],
     [
      2,
      3
     ]
    ]
   ],
   "expected": [
    2,
    3
   ]
  },
  {
   "name": "long cycle",
   "args": [
    [
     [
      1,
      2
     ],
     [
      2,
      3
     ],
     [
      3,
      4
     ],
     [
      4,
      5
     ],
     [
      5,
      1
     ]
    ]
   ],
   "expected": [
    5,
    1
   ]
  },
  {
   "name": "first edges form the cycle",
   "args": [
    [
     [
      1,
      2
     ],
     [
      2,
      3
     ],
     [
      3,
      1
     ],
     [
      1,
      4
     ]
    ]
   ],
   "expected": [
    3,
    1
   ]
  }
 ]
}
