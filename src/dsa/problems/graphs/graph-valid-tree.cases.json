{
 "fn": "valid_tree",
 "cases": [
  {
   "name": "a tree",
   "args": [
    5,
    [
     [
      0,
      1
     ],
     [
      0,
      2
     ],
     [
      0,
      3
     ],
     [
      1,
      4
     ]
    ]
   ],
   "expected": true
  },
  {
   "name": "has a cycle",
   "args": [
    5,
    [
     [
      0,
      1
     ],
     [
      1,
      2
     ],
     [
      2,
      3
     ],
     [
      1,
      3
     ],
     [
      1,
      4
     ]
    ]
   ],
   "expected": false
  },
  {
   "name": "disconnected",
   "args": [
    4,
    [
     [
      0,
      1
     ],
     [
      2,
      3
     ]
    ]
   ],
   "expected": false
  },
  {
   "name": "single node",
   "args": [
    1,
    []
   ],
   "expected": true
  },
  {
   "name": "two nodes joined",
   "args": [
    2,
    [
     [
      0,
      1
     ]
    ]
   ],
   "expected": true
  },
  {
   "name": "two nodes apart",
   "args": [
    2,
    []
   ],
   "expected": false
  },
  {
   "name": "right count but a cycle",
   "args": [
    4,
    [
     [
      0,
      1
     ],
     [
      1,
      2
     ],
     [
      2,
      0
     ]
    ]
   ],
   "expected": false
  },
  {
   "name": "path",
   "args": [
    4,
    [
     [
      0,
      1
     ],
     [
      1,
      2
     ],
     [
      2,
      3
     ]
    ]
   ],
   "expected": true
  }
 ]
}
