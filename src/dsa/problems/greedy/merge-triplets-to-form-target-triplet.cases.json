      2,
      1,
      1
     ],
     [
      1,
      3,
      1
     ],
     [
      1,
      1,
      4
     ]
    ],
    [
     2,
     3,
     4
    ]
   ],
   "expected": true
  },
  {
   "name": "a too-large triplet is unusable",
   "args": [
    [
     [
      2,
      1,
      1
     ],
     [
      1,
      3,
      1
     ],
     [
      1,
      1,
      4
     ],
     [
      9,
      9,
      9
     ]
    ],
    [
     2,
     3,
     4
    ]
   ],
   "expected": true
  },
  {
   "name": "missing a position",
   "args": [
    [
     [
      1,
      1,
      1
     ],
     [
      2,
      2,
      1
     ]
    ],
    [
     2,
     2,
     3
    ]
   ],
   "expected": false
  },
  {
   "name": "single exact triplet",
   "args": [
    [
     [
      3,
      3,
      3
     ]
    ],
    [
     3,
     3,
     3
    ]
   ],
   "expected": true
  },
  {
   "name": "single wrong triplet",
   "args": [
    [
