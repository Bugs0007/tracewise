{
 "fn": "get_sum",
 "cases": [
  {
   "name": "small",
   "args": [
    5,
    7
   ],
   "expected": 12
  },
  {
   "name": "with zero",
   "args": [
    0,
    9
   ],
   "expected": 9
  },
  {
   "name": "negative result",
   "args": [
    -4,
    -9
   ],
   "expected": -13
  },
  {
   "name": "cancel out",
   "args": [
    6,
    -6
   ],
   "expected": 0
