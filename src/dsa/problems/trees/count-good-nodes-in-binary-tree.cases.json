{
 "fn": "good_nodes",
 "cases": [
  {
   "name": "mixed",
   "args": [
    [
     3,
     1,
     4,
     3,
     null,
     1,
     5
    ]
   ],
   "expected": 4
  },
  {
   "name": "only the root is good",
   "args": [
    [
     5,
     3,
     2,
     1
    ]
   ],
   "expected": 1
  },
  {
   "name": "single node",
   "args": [
    [
     7
    ]
   ],
   "expected": 1
  },
  {
   "name": "all good",
   "args": [
    [
     1,
     2,
     3,
     4,
     5
    ]
   ],
   "expected": 5
  },
  {
   "name": "negative values",
   "args": [
    [
     -1,
     -2,
     -3,
     -4
    ]
   ],
   "expected": 1
  },
  {
   "name": "equal values count as good",
   "args": [
    [
     2,
     2,
     2
    ]
   ],
   "expected": 3
  },
  {
   "name": "deeper",
   "args": [
    [
     3,
     3,
     null,
     4,
     2
    ]
   ],
   "expected": 3
  }
 ]
}
