{
 "fn": "min_interval",
 "cases": [
  {
   "name": "smallest containing interval",
   "args": [
    [
     [
      1,
      6
     ],
     [
      2,
      4
     ],
     [
      5,
      9
     ]
    ],
    [
     3,
     5,
     12
    ]
   ],
   "expected": [
    3,
    5,
    -1
   ]
  },
  {
   "name": "no interval",
   "args": [
    [
     [
      4,
      5
     ]
    ],
    [
     1,
     9
    ]
   ],
   "expected": [
    -1,
    -1
   ]
  },
  {
   "name": "single point interval",
   "args": [
    [
     [
      7,
      7
     ]
    ],
    [
     7,
     8
    ]
   ],
   "expected": [
    1,
    -1
   ]
  },
  {
   "name": "queries out of order",
   "args": [
    [
     [
      1,
      10
     ],
     [
      3,
      5
     ]
    ],
    [
     6,
     4,
     3
    ]
   ],
   "expected": [
    10,
    3,
    3
   ]
  },
  {
   "name": "duplicate queries",
   "args": [
    [
     [
      2,
      8
     ],
     [
      3,
      4
     ]
    ],
    [
     3,
     3,
     9
    ]
   ],
   "expected": [
