  {
   "name": "carry chain",
   "args": [
    255,
    1
   ],
   "expected": 256
  },
  {
   "name": "mixed signs",
   "args": [
    -3,
    10
   ],
   "expected": 7
  },
  {
   "name": "large",
   "args": [
    123456,
    654321
   ],
   "expected": 777777
  },
  {
   "name": "both negative",
