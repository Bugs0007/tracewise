{
 "fn": "max_sub_array",
 "cases": [
  {
   "name": "a dip is worth crossing",
   "args": [
    [
     2,
     -1,
     3,
     -4,
     5,
     1
    ]
   ],
   "expected": 6
  },
  {
   "name": "single number",
   "args": [
    [
     -4
    ]
   ],
   "expected": -4
  },
  {
   "name": "all negative",
   "args": [
    [
     -5,
     -2,
     -8
    ]
   ],
   "expected": -2
  },
  {
   "name": "all positive",
   "args": [
    [
     1,
     2,
     3
    ]
   ],
   "expected": 6
  },
  {
   "name": "restart after a deep dip",
   "args": [
    [
     3,
     -10,
     4,
     1
    ]
   ],
   "expected": 5
  },
  {
   "name": "zeros",
   "args": [
    [
     0,
     0,
     -1,
     0
    ]
   ],
   "expected": 0
  },
  {
   "name": "alternating",
   "args": [
    [
     5,
     -4,
     5,
     -4,
     5
    ]
   ],
   "expected": 7
  }
 ]
}
