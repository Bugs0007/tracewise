   ],
   "expected": [
    [
     1,
     2,
     2
    ],
    [
     5
    ]
   ]
  },
  {
   "name": "duplicates at the end",
   "args": [
    [
     1,
     2,
     3,
     3,
     3
    ],
    6
   ],
   "expected": [
    [
     3,
     3
    ],
    [
     1,
     2,
     3
