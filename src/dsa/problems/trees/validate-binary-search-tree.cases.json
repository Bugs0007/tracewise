{
 "fn": "is_valid_bst",
 "cases": [
  {
   "name": "valid",
   "args": [
    [
     8,
     4,
     12,
     2,
     6,
     10,
     14
    ]
   ],
   "expected": true
  },
  {
   "name": "right child smaller than root",
   "args": [
    [
     5,
     1,
     4,
     null,
     null,
     3,
     6
    ]
   ],
   "expected": false
  },
  {
   "name": "deep violation",
   "args": [
    [
     10,
     5,
     15,
     null,
     null,
     6,
     20
    ]
   ],
   "expected": false
  },
  {
   "name": "single node",
   "args": [
    [
     1
    ]
   ],
   "expected": true
  },
  {
   "name": "empty",
   "args": [
    []
   ],
   "expected": true
  },
  {
   "name": "equal values are invalid",
   "args": [
    [
     2,
     2,
     2
    ]
   ],
   "expected": false
  },
  {
   "name": "valid skewed",
   "args": [
    [
     3,
     2,
     null,
     1
    ]
   ],
   "expected": true
  }
 ]
}
