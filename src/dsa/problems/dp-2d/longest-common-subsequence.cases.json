{
 "fn": "longest_common_subsequence",
 "cases": [
  {
   "name": "interleaved letters",
   "args": [
    "axbycz",
    "abc"
   ],
   "expected": 3
  },
  {
   "name": "nothing shared",
   "args": [
    "abc",
    "xyz"
   ],
   "expected": 0
  },
  {
   "name": "identical",
   "args": [
    "hello",
    "hello"
   ],
   "expected": 5
  },
  {
   "name": "one empty",
   "args": [
    "abc",
    ""
   ],
   "expected": 0
  },
  {
   "name": "both empty",
   "args": [
    "",
    ""
   ],
   "expected": 0
  },
  {
   "name": "order matters",
   "args": [
    "abc",
    "cba"
   ],
   "expected": 1
  },
  {
   "name": "repeated letters",
   "args": [
    "aabba",
    "ababa"
   ],
   "expected": 4
  },
  {
   "name": "one is inside the other",
   "args": [
    "pqr",
    "xpyqzr"
   ],
   "expected": 3
  }
 ]
}
