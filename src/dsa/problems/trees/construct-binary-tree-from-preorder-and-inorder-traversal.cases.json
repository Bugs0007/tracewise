{
 "fn": "build_tree",
 "cases": [
  {
   "name": "full tree",
   "args": [
    [
     4,
     2,
     1,
     3,
     6,
     5,
     7
    ],
    [
     1,
     2,
     3,
     4,
     5,
     6,
     7
    ]
   ],
   "expected": [
    4,
    2,
    6,
    1,
    3,
    5,
    7
   ]
  },
  {
   "name": "single node",
   "args": [
    [
     9
    ],
    [
     9
    ]
   ],
   "expected": [
    9
   ]
  },
  {
   "name": "empty",
   "args": [
    [],
    []
   ],
   "expected": []
  },
  {
   "name": "left chain",
   "args": [
    [
     3,
     2,
     1
    ],
    [
     1,
     2,
     3
    ]
   ],
   "expected": [
    3,
    2,
    null,
    1
   ]
  },
  {
   "name": "right chain",
   "args": [
    [
     1,
     2,
     3
    ],
    [
     1,
     2,
     3
    ]
   ],
   "expected": [
    1,
    null,
    2,
    null,
    3
   ]
  },
  {
   "name": "uneven",
   "args": [
    [
     10,
     5,
     7,
     15,
     12,
     6
    ],
    [
     5,
     7,
     10,
     6,
     12,
     15
    ]
   ],
   "expected": [
    10,
    5,
    15,
    null,
    7,
    12,
    null,
    null,
    null,
    6
   ]
  },
  {
   "name": "two nodes",
   "args": [
    [
     1,
     2
    ],
    [
     2,
     1
    ]
   ],
   "expected": [
    1,
    2
   ]
  }
 ]
}
