{
 "fn": "length_of_lis",
 "cases": [
  {
   "name": "not contiguous",
   "args": [
    [
     5,
     1,
     6,
     2,
     7,
     3,
     8
    ]
   ],
   "expected": 4
  },
  {
   "name": "single",
   "args": [
    [
     4
    ]
   ],
   "expected": 1
  },
  {
   "name": "decreasing",
   "args": [
    [
     9,
     7,
     5,
     3
    ]
   ],
   "expected": 1
  },
  {
   "name": "increasing",
   "args": [
    [
     1,
     2,
     3,
     4,
     5
    ]
   ],
   "expected": 5
  },
  {
   "name": "equal values do not count",
   "args": [
    [
     2,
     2,
     2,
     2
    ]
   ],
   "expected": 1
  },
  {
   "name": "zigzag",
   "args": [
    [
     3,
     1,
     4,
     1,
     5,
     9,
     2,
     6
    ]
   ],
   "expected": 4
  },
  {
   "name": "negatives",
   "args": [
    [
     -3,
     -1,
     -2,
     0,
     -4,
     2
    ]
   ],
   "expected": 4
  },
  {
   "name": "empty",
   "args": [
    []
   ],
   "expected": 0
  }
 ]
}
