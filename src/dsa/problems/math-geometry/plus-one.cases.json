{
 "fn": "plus_one",
 "cases": [
  {
   "name": "no carry",
   "args": [
    [
     1,
     2,
     3
    ]
   ],
   "expected": [
    1,
    2,
    4
   ]
  },
  {
   "name": "carry through nines",
   "args": [
    [
     2,
     9,
     9
    ]
   ],
   "expected": [
    3,
    0,
    0
   ]
  },
  {
   "name": "all nines",
   "args": [
    [
     9,
     9,
     9
    ]
   ],
   "expected": [
    1,
    0,
    0,
    0
   ]
  },
  {
   "name": "single digit",
   "args": [
    [
     4
    ]
   ],
   "expected": [
    5
   ]
  },
  {
   "name": "single nine",
   "args": [
    [
     9
    ]
   ],
   "expected": [
    1,
    0
   ]
  },
  {
   "name": "zero",
   "args": [
    [
     0
    ]
   ],
   "expected": [
    1
   ]
  },
  {
   "name": "carry into the middle",
   "args": [
    [
     1,
     9,
     9,
     8
    ]
   ],
   "expected": [
    1,
    9,
    9,
    9
   ]
  }
 ]
}
