      2
     ]
    ],
    [
     3,
     3,
     3
    ]
   ],
   "expected": false
  },
  {
   "name": "one triplet covers all",
   "args": [
    [
     [
      1,
      2,
      3
     ],
     [
      5,
      5,
      5
     ]
    ],
    [
     1,
     2,
     3
    ]
   ],
   "expected": true
  },
  {
   "name": "blocked by one large entry",
   "args": [
    [
     [
      5,
      1,
      1
     ],
     [
      1,
      5,
      1
     ],
     [
      1,
      1,
      5
     ],
     [
      1,
      1,
      9
     ]
    ],
    [
