{
 "fn": "Codec",
 "cases": [
  {
   "name": "typical",
   "args": [
    [
     1,
     2,
     3,
     null,
     null,
     4,
     5
    ]
   ],
   "expected": [
    1,
    2,
    3,
    null,
    null,
    4,
    5
   ]
  },
  {
   "name": "empty",
   "args": [
    []
   ],
   "expected": []
  },
  {
   "name": "single node",
   "args": [
    [
     7
    ]
   ],
   "expected": [
    7
   ]
  },
  {
   "name": "negative values",
   "args": [
    [
     -1,
     -2,
     -3,
     -4
    ]
   ],
   "expected": [
    -1,
    -2,
    -3,
    -4
   ]
  },
  {
   "name": "left chain",
   "args": [
    [
     1,
     2,
     null,
     3,
     null,
     4
    ]
   ],
   "expected": [
    1,
    2,
    null,
    3,
    null,
    4
   ]
  },
  {
   "name": "right chain",
   "args": [
    [
     1,
     null,
     2,
     null,
     3
    ]
   ],
   "expected": [
    1,
    null,
    2,
    null,
    3
   ]
  },
  {
   "name": "larger values",
   "args": [
    [
     100,
     250,
     -300,
     1000
    ]
   ],
   "expected": [
    100,
    250,
    -300,
    1000
   ]
  }
 ]
}
