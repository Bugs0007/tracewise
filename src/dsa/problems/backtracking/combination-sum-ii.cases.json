    [
     3,
     6
    ],
    [
     9
    ]
   ]
  },
  {
   "name": "all equal",
   "args": [
    [
     2,
     2,
     2,
     2
    ],
    4
   ],
   "expected": [
    [
     2,
     2
    ]
   ]
  },
  {
   "name": "no way",
   "args": [
    [
     3,
     4,
     5
