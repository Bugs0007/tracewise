{
 "fn": "eval_rpn",
 "cases": [
  {
   "name": "add then multiply",
   "args": [
    [
     "3",
     "4",
     "+",
     "2",
     "*"
    ]
   ],
   "expected": 14
  },
  {
   "name": "single number",
   "args": [
    [
     "42"
    ]
   ],
   "expected": 42
  },
  {
   "name": "subtraction order",
   "args": [
    [
     "10",
     "4",
     "-"
    ]
   ],
   "expected": 6
  },
  {
   "name": "division truncates toward zero",
   "args": [
    [
     "7",
     "2",
     "/"
    ]
   ],
   "expected": 3
  },
  {
   "name": "negative division truncates toward zero",
   "args": [
    [
     "-7",
     "2",
     "/"
    ]
   ],
   "expected": -3
  },
  {
   "name": "negative operands",
   "args": [
    [
     "-3",
     "-4",
     "*",
     "5",
     "+"
    ]
   ],
   "expected": 17
  },
  {
   "name": "deeper tree",
   "args": [
    [
     "2",
     "1",
     "+",
     "3",
     "*",
     "9",
     "6",
     "/",
     "-"
    ]
   ],
   "expected": 8
  },
  {
   "name": "division by a larger number",
   "args": [
    [
     "1",
     "5",
     "/"
    ]
   ],
   "expected": 0
  },
  {
   "name": "longer chain",
   "args": [
    [
     "5",
     "1",
     "2",
     "+",
     "4",
     "*",
     "+",
     "3",
     "-"
    ]
   ],
   "expected": 14
  }
 ]
}
