{
 "fn": "three_sum",
 "compare": "nested",
 "cases": [
  {
   "name": "two triples",
   "args": [
    [
     -5,
     1,
     4,
     2,
     -3,
     1,
     2
    ]
   ],
   "expected": [
    [
     -5,
     1,
     4
    ],
    [
     -3,
     1,
     2
    ]
   ]
  },
  {
   "name": "no triple",
   "args": [
    [
     1,
     2,
     4,
     7
    ]
   ],
   "expected": []
  },
  {
   "name": "all zeros",
   "args": [
    [
     0,
     0,
     0,
     0,
     0
    ]
   ],
   "expected": [
    [
     0,
     0,
     0
    ]
   ]
  },
  {
   "name": "fewer than three numbers",
   "args": [
    [
     0,
     0
    ]
   ],
   "expected": []
  },
  {
   "name": "empty",
   "args": [
    []
   ],
   "expected": []
  },
  {
   "name": "duplicates must not repeat triples",
   "args": [
    [
     -2,
     -2,
     0,
     0,
     2,
     2,
     2
    ]
   ],
   "expected": [
    [
     -2,
     0,
     2
    ]
   ]
  },
  {
   "name": "one big negative",
   "args": [
    [
     -9,
     2,
     3,
     4,
     5,
     7
    ]
   ],
   "expected": [
    [
     -9,
     4,
     5
    ],
    [
     -9,
     2,
     7
    ]
   ]
  },
  {
   "name": "many triples",
   "args": [
    [
     -4,
     -2,
     -2,
     -1,
     0,
     1,
     2,
     2,
     3,
     4
    ]
   ],
   "expected": [
    [
     -1,
     0,
     1
    ],
    [
     -4,
     1,
     3
    ],
    [
     -4,
     2,
     2
    ],
    [
     -2,
     -2,
     4
    ],
    [
     -4,
     0,
     4
    ],
    [
     -2,
     -1,
     3
    ],
    [
     -2,
     0,
     2
    ]
   ]
  }
 ]
}
