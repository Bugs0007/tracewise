{
 "fn": "invert_tree",
 "cases": [
  {
   "name": "full tree",
   "args": [
    [
     4,
     2,
     7,
     1,
     3,
     6,
     9
    ]
   ],
   "expected": [
    4,
    7,
    2,
    9,
    6,
    3,
    1
   ]
  },
  {
   "name": "skewed left",
   "args": [
    [
     5,
     3,
     null,
     2,
     null,
     1
    ]
   ],
   "expected": [
    5,
    null,
    3,
    null,
    2,
    null,
    1
   ]
  },
  {
   "name": "single node",
   "args": [
    [
     8
    ]
   ],
   "expected": [
    8
   ]
  },
  {
   "name": "empty",
   "args": [
    []
   ],
   "expected": []
  },
  {
   "name": "only a right child",
   "args": [
    [
     1,
     null,
     2
    ]
   ],
   "expected": [
    1,
    2
   ]
  },
  {
   "name": "uneven",
   "args": [
    [
     10,
     5,
     15,
     null,
     7,
     12,
     null,
     null,
     null,
     6
    ]
   ],
   "expected": [
    10,
    15,
    5,
    null,
    12,
    7,
    null,
    null,
    6
   ]
  }
 ]
}
