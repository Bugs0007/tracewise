    2,
    -1
   ]
  },
  {
   "name": "empty intervals",
   "args": [
    [],
    [
     1,
     2
    ]
   ],
   "expected": [
    -1,
    -1
   ]
  },
  {
   "name": "nested",
   "args": [
    [
     [
      1,
      20
     ],
     [
      5,
      15
     ],
     [
      8,
      10
     ]
    ],
    [
     9,
