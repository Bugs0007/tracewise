{
  "name": "tracewise",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive, visual, gamified interview-prep console for software engineers. Static, offline-capable, no backend.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:content": "vitest run src/content",
    "check:unit": "node scripts/check-unit.mjs",
    "coverage:docs": "vitest run scripts/gen-coverage.test.ts",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@supabase/supabase-js": "^2.117.3",
    "acorn": "^8.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sucrase": "^3.35.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pyodide": "0.29.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
